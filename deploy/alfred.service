# alfred — systemd USER unit. Install with deploy/install.sh (do not enable
# both this and a system unit). Config lives in %h/.config/alfred.env (optional).
[Unit]
Description=alfred agent platform (server + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/alfred
EnvironmentFile=-%h/.config/alfred.env
Environment=ALFRED_NOTIFY_DESKTOP=0
ExecStart=%h/repos/alfred/bin/alfred serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
